      "get": {
        "summary": "Discover Datasets for a Specific Pincode",
        "description": "Returns metadata, schema definitions, column data types, row counts, and endpoint URLs for all 6 tables.",
        "parameters": [
          {
            "name": "pincode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "560034"
