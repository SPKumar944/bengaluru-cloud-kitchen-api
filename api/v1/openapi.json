  "info": {
    "title": "AGT Intelligence | Bengaluru Cloud Kitchen & Retail Footfall REST API",
    "version": "1.0.4",
    "description": "High-throughput, standardized geospatial, F&B competitor, housing proxy, and OSRM mobility intelligence across Bengaluru prime economic corridors (560034, 560041, 560038, 560102). Served via global CDN with CORS enabled.",
    "contact": {
      "name": "AGT Intelligence Support Team",
      "url": "https://agt-intelligence.com"
    }
  },
  "servers": [
    {
      "url": "https://spkumar944.github.io/bengaluru-cloud-kitchen-api/api/v1",
      "description": "Production Edge CDN (AGT Intelligence Gateway)"
    }
  ],
  "paths": {
    "/pincodes.json": {
      "get": {
        "summary": "List All Analyzed Pincodes",
        "description": "Returns all 4 analyzed market corridors with centroids, bounding boxes, entity counts, feasibility scores, and recommended kitchen hub coordinates.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/summary.json": {
      "get": {
        "summary": "Cross-Market Overview & GMV Analytics",
        "description": "Aggregated market saturation, order counts, and estimated GMV across all analyzed pincodes.",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
